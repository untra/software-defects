{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "challenge"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "artifact"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest",
              "artifact_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "artifact_id",
            "path"
          ],
          "additionalProperties": false
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expected_property": {
                "type": "string",
                "minLength": 1
              },
              "variation": {
                "enum": [
                  "reassignment",
                  "alias",
                  "early_return",
                  "nested_scope",
                  "exception",
                  "schedule",
                  "benign"
                ]
              }
            },
            "required": [
              "description",
              "expected_property",
              "variation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "hypothesis",
        "cases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "producer",
    "inputs",
    "configuration_hash",
    "completeness",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-lens.local/schemas/challenge.schema.json"
}
