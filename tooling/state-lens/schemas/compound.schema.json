{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "compound"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "artifact"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest",
              "artifact_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "structure": {
          "enum": [
            "chain",
            "composite"
          ]
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "result": {
                "enum": [
                  "established",
                  "refuted",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "uri",
                    "source_hash",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "predicate",
              "arguments",
              "result",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "ordering": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "result": {
                "enum": [
                  "established",
                  "refuted",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "uri",
                    "source_hash",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "predicate",
              "arguments",
              "result",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "breakers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "result": {
                "enum": [
                  "established",
                  "refuted",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "uri",
                    "source_hash",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "predicate",
              "arguments",
              "result",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "outcome_property": {
          "type": "string",
          "minLength": 1
        },
        "cwes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "structure",
        "ingredients",
        "relationships",
        "ordering",
        "breakers",
        "outcome_property",
        "cwes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "producer",
    "inputs",
    "configuration_hash",
    "completeness",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-lens.local/schemas/compound.schema.json"
}
