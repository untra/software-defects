{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "state_graph"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "artifact"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "byte_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "byte_digest",
              "artifact_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "graphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateGraph"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateTrace"
          }
        }
      },
      "required": [
        "graphs",
        "traces"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "producer",
    "inputs",
    "configuration_hash",
    "completeness",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-lens.local/schemas/state_graph.schema.json",
  "$defs": {
    "DocumentIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "uri",
        "source_hash",
        "byte_length",
        "version"
      ],
      "additionalProperties": false
    },
    "BindingIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": [
        "id",
        "location"
      ],
      "additionalProperties": false
    },
    "AllocationIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "operation"
      ],
      "additionalProperties": false
    },
    "BasicBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "operations"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/Predicate"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "predicate",
        "uncertainty",
        "evidence"
      ],
      "additionalProperties": false
    },
    "AccessPath": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathSegment"
          }
        }
      },
      "required": [
        "id",
        "root",
        "segments"
      ],
      "additionalProperties": false
    },
    "CallContext": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "call": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent",
        "call"
      ],
      "additionalProperties": false
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "document": {
          "type": "string"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "range": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "id",
        "document",
        "source_hash",
        "range"
      ],
      "additionalProperties": false
    },
    "ControlFlowEdge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "branch": {
          "$ref": "#/$defs/Branch"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "from",
        "to",
        "branch",
        "condition",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Obligation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "language_model": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "id",
        "operation",
        "condition",
        "language_model",
        "assumptions",
        "evidence",
        "outcome"
      ],
      "additionalProperties": false
    },
    "InvalidationStatus": {
      "enum": [
        "invalidated",
        "never_established",
        "unknown"
      ]
    },
    "Outcome": {
      "enum": [
        "established",
        "violated_on_demonstrated_path",
        "potential_violation",
        "unknown"
      ]
    },
    "Branch": {
      "enum": [
        "unconditional",
        "true",
        "false",
        "exceptional"
      ]
    },
    "Comparison": {
      "enum": [
        "equal",
        "not_equal",
        "less",
        "less_equal",
        "greater",
        "greater_equal"
      ]
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "field"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "index"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dereference"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "comparison"
            },
            "operator": {
              "$ref": "#/$defs/Comparison"
            },
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "conjunction"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "disjunction"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nonzero"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "valid_index"
            },
            "index": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index",
            "collection"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resource_state"
            },
            "resource": {
              "type": "string"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "resource",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ownership"
            },
            "owner": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "owner",
            "location"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "independence"
            },
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "Location": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "uri",
        "range"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "call_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "identity",
        "binding_id",
        "allocation_id",
        "block_id",
        "access_path",
        "call_context",
        "required_conditions",
        "evidence",
        "id",
        "kind",
        "location",
        "binding",
        "guards"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        },
        "relationship": {
          "$ref": "#/$defs/Relationship"
        }
      },
      "required": [
        "from",
        "to",
        "relationship"
      ],
      "additionalProperties": false
    },
    "StateGraph": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": 2
        },
        "snapshot_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentIdentity"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BindingIdentity"
          }
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllocationIdentity"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BasicBlock"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "access_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPath"
          }
        },
        "call_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallContext"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          }
        },
        "control_flow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlFlowEdge"
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obligation"
          }
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "snapshot_id",
        "generation",
        "documents",
        "bindings",
        "allocations",
        "blocks",
        "conditions",
        "access_paths",
        "call_contexts",
        "evidence",
        "control_flow",
        "obligations",
        "source_hash",
        "operations",
        "edges",
        "limitations"
      ],
      "additionalProperties": false
    },
    "StateTrace": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": 2
        },
        "snapshot_id": {
          "type": "string"
        },
        "origin_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidation_status": {
          "$ref": "#/$defs/InvalidationStatus"
        },
        "invalidating_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "invalidations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "affected_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "required_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "snapshot_id",
        "origin_operations",
        "invalidation_status",
        "invalidating_operations",
        "affected_operations",
        "supporting_evidence",
        "required_conditions",
        "evidence_level",
        "source_hash",
        "origins",
        "invalidations",
        "affected_uses",
        "required_condition",
        "operations",
        "edges",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "OperationKind": {
      "enum": [
        "read",
        "write",
        "allocation",
        "call",
        "return",
        "exceptional_exit",
        "guard",
        "suspension"
      ]
    },
    "Relationship": {
      "enum": [
        "reaching_assignment",
        "value_dependency",
        "governed_by"
      ]
    },
    "EvidenceLevel": {
      "enum": [
        "candidate_relationship",
        "feasible_under_model",
        "reproduced"
      ]
    }
  }
}
