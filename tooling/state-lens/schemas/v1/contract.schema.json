{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "contract"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "result": {
                "enum": [
                  "established",
                  "refuted",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "uri",
                    "source_hash",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "predicate",
              "arguments",
              "result",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact_id",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "review_status": {
          "enum": [
            "proposed",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "property",
        "applicability",
        "provenance",
        "review_status",
        "reviewer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "producer",
    "inputs",
    "configuration_hash",
    "completeness",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-lens.local/schemas/contract.schema.json"
}
