{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "finding"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "uri",
              "source_hash",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "invalidation_status": {
          "enum": [
            "invalidated",
            "never_established",
            "unknown"
          ]
        },
        "invalidations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "uri",
              "source_hash",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "affected_uses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "uri",
              "source_hash",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "supporting_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "uri",
              "source_hash",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "evidence_level": {
          "enum": [
            "candidate_relationship",
            "feasible_under_model",
            "reproduced"
          ]
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
