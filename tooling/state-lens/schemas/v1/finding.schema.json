  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "producer",
    "inputs",
    "configuration_hash",
    "completeness",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-lens.local/schemas/finding.schema.json"
}
