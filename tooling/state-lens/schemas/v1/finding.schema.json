      "required": [
        "origins",
        "invalidation_status",
        "invalidations",
        "affected_uses",
        "supporting_spans",
        "evidence_level",
        "predicates",
        "assumptions",
        "witness",
        "exploitability"
      ],
      "additionalProperties": false
