                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "uri": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "uri",
                        "source_hash",
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "predicate",
                  "arguments",
                  "result",
                  "evidence"
                ],
                "additionalProperties": false
              }
            },
            "reachability": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "predicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "result": {
                    "enum": [
                      "established",
                      "refuted",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "uri": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "uri",
                        "source_hash",
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "predicate",
                  "arguments",
                  "result",
                  "evidence"
                ],
                "additionalProperties": false
