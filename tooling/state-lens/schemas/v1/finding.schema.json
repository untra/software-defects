              "type": [
                "string",
                "null"
              ]
            },
            "security_property": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "actor_control",
            "reachability",
            "boundary",
            "security_property"
          ],
          "additionalProperties": false
