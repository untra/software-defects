                    "minLength": 1
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "result": {
                    "enum": [
                      "established",
                      "refuted",
                      "unknown"
                    ]
